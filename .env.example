# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
MONGODB_URI=mongodb://localhost:27017/ai-genius

# JWT Configuration
JWT_SECRET=your_jwt_access_secret_change_me_in_production_at_least_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_me_in_production_at_least_32_chars

# JWT Expiration Settings
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
